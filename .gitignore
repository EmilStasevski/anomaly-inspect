# Dataset: CC BY-NC-SA 4.0, must never be committed or redistributed
# Do not use a `/data/*` + negation pattern: DVC then treats the directory as ignored and
# silently stops seeing its .dvc pointer files.
/data/mvtec_ad/
/data/*.tar*
/data/*.zip

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Run outputs
/mlruns/
/mlflow-data/
/outputs/
# Model outputs. Versioned through DVC, not git.
/models/**/meta.json
/models/**/model.json
*.onnx
*.onnx.data
*.ckpt
*.pt
*.pth
/results/*.tmp
lightning_logs/

# Rust
/serving/target/

# DVC local cache and remote
/.dvc/cache
/.dvc/tmp
/.dvc-remote/

.env
.idea/
.vscode/
